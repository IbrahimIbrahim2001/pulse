{
  "version": 2,
  "builds": [
    {
      "src": "apps/server/src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/apps/server/dist/index.js"
    }
  ],
  "functions": {
    "apps/server/dist/index.js": {
      "maxDuration": 30
    }
  }
}