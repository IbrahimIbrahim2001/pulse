{
  "version": 3,
  "builds": [
    {
      "src": "apps/server/src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/apps/server/index.ts"
    },
    {
      "src": "/trpc/(.*)",
      "dest": "/apps/server/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/apps/server/index.ts"
    }
  ],
  "functions": {
    "apps/server/index.ts": {
      "maxDuration": 30
    }
  },
  "installCommand": "bun install",
  "buildCommand": "bun run build"
}